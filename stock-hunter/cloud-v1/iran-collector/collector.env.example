# Never place real secrets in this file in the public repository.
STOCK_HUNTER_INGEST_URL=https://<worker-host>/v1/ingest
STOCK_HUNTER_COLLECTOR_ID=iran-primary
STOCK_HUNTER_COLLECTOR_SECRET=replace-with-a-long-random-secret
STOCK_HUNTER_INTERVAL_SECONDS=30
STOCK_HUNTER_STATE_DIR=/var/lib/stock-hunter-collector
STOCK_HUNTER_SPOOL_MAX_BYTES=104857600
STOCK_HUNTER_SPOOL_MAX_AGE_SECONDS=3600

# Optional. Keep default unless a verified Iran-accessible TSETMC endpoint is required.
# STOCK_HUNTER_TSETMC_BASE=https://old.tsetmc.com/tsev2/data/
